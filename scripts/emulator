#!/usr/bin/env python3

import os
import re
import subprocess
import sys
from pathlib import Path

AVD_NAME = "moneta"
SDK_PACKAGE = "system-images;android-36;google_apis;x86_64"

AVD_SETTINGS = {
    "hw.keyboard": "yes",
    "hw.gpu.enabled": "yes",
    "hw.gpu.mode": "host",
    "vm.heapSize": "256M",
}

# SwiftShader renders on the host processor when the host driver is unreachable.
GPU_MODES = ["host", "swiftshader_indirect"]

def main():
    """Main function."""
    # Check if AVD exists, create if not
    if not avd_exists(AVD_NAME):
        if not create_avd(AVD_NAME, SDK_PACKAGE):
            print("Failed to create AVD")
            sys.exit(1)
    else:
        print(f"AVD '{AVD_NAME}' already exists.")

    configure_avd(AVD_NAME, AVD_SETTINGS)

    # Start emulator, forwarding any extra options (for example -no-window)
    start_emulator(AVD_NAME, sys.argv[1:])

def run_command(cmd, input_text=None, capture_output=True):
    """Run a shell command and return the result."""
    try:
        result = subprocess.run(
            cmd,
            shell=True,
            input=input_text,
            text=True,
            capture_output=capture_output
        )
        return result
    except subprocess.SubprocessError as e:
        print(f"Error running command '{cmd}': {e}")
        return None

def avd_exists(avd_name):
    """Check if AVD already exists."""
    result = run_command("avdmanager list avd")
    if result and result.returncode == 0:
        return avd_name in result.stdout
    return False

def create_avd(avd_name, sdk_package):
    """Create a new AVD."""
    print(f"Creating AVD: {avd_name}")
    cmd = f"avdmanager create avd --name \"{avd_name}\" --package \"{sdk_package}\""
    result = run_command(cmd, input_text="no\n", capture_output=False)
    return result and result.returncode == 0

def configure_avd(avd_name, settings):
    """Apply the settings to the AVD config, keeping what is already right."""
    avd_home = Path(
        os.environ.get("ANDROID_AVD_HOME", Path.home() / ".android" / "avd"))
    config_file = avd_home / f"{avd_name}.avd" / "config.ini"

    if not config_file.exists():
        print(f"Warning: AVD config file not found at {config_file}")
        return False

    with open(config_file, "r") as f:
        content = f.read()

    updated = content
    for key, value in settings.items():
        pattern = rf"^{re.escape(key)}\s*=\s*.*$"
        if re.search(pattern, updated, flags=re.MULTILINE):
            updated = re.sub(
                pattern, f"{key}={value}", updated, flags=re.MULTILINE)
        else:
            updated += f"\n{key}={value}\n"

    if updated == content:
        return True

    print(f"Updating settings in {config_file}")
    with open(config_file, "w") as f:
        f.write(updated)
    return True

def start_emulator(avd_name, options):
    """Start the emulator, falling back through the GPU modes."""
    extra = " ".join(options)
    for gpu_mode in GPU_MODES:
        print(f"Starting emulator: {avd_name} (-gpu {gpu_mode}) {extra}")
        cmd = f"emulator -avd \"{avd_name}\" -gpu {gpu_mode} {extra}"
        result = run_command(cmd, capture_output=False)
        if result and result.returncode == 0:
            return True
        print(f"Emulator failed with -gpu {gpu_mode}")
    return False

if __name__ == "__main__":
    main()
